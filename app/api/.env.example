# Postgres connection (local Docker Compose or Neon connection string in deployed environments)
DATABASE_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
DATABASE_USERNAME=<neon-user>
DATABASE_PASSWORD=<neon-password>

# JWT - generate a long random value, e.g. `openssl rand -base64 64`
JWT_SECRET=<replace-with-a-strong-random-secret>
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mutual fund market-data provider (Phase 3). Leave unset to use the built-in demo/dev provider.
# Set MUTUAL_FUND_PROVIDER_NAME to a real provider's bean name once one is implemented.
MUTUAL_FUND_PROVIDER_NAME=demo
MUTUAL_FUND_PROVIDER_URL=
MUTUAL_FUND_PROVIDER_API_KEY=
MUTUAL_FUND_PROVIDER_TIMEOUT=5000
MUTUAL_FUND_PROVIDER_MAX_RETRIES=3
# Must stay false unless a real provider is configured - gates the scheduled sync job
MUTUAL_FUND_PROVIDER_ENABLED=false
# Cron expression for scheduled sync, e.g. "0 0 2 * * *"; "-" (default) disables scheduling
MUTUAL_FUND_SYNC_CRON=-

# Redis is not yet wired up (see finadvisor.config.CacheConfig) - reserved for future use
REDIS_URL=
