# Postgres connection (local Docker Compose or Neon connection string in deployed environments)
DATABASE_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
DATABASE_USERNAME=<neon-user>
DATABASE_PASSWORD=<neon-password>

# JWT - generate a long random value, e.g. `openssl rand -base64 64`
JWT_SECRET=<replace-with-a-strong-random-secret>
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mutual fund market-data provider (Phase 3). Leave unset to use the built-in demo/dev provider.
# Set MUTUAL_FUND_PROVIDER_NAME to a real provider's bean name once one is implemented.
MUTUAL_FUND_PROVIDER_NAME=demo
MUTUAL_FUND_PROVIDER_URL=
MUTUAL_FUND_PROVIDER_API_KEY=
MUTUAL_FUND_PROVIDER_TIMEOUT=5000
MUTUAL_FUND_PROVIDER_MAX_RETRIES=3
# Must stay false unless a real provider is configured - gates the scheduled sync job
MUTUAL_FUND_PROVIDER_ENABLED=false
# Cron expression for scheduled sync, e.g. "0 0 2 * * *"; "-" (default) disables scheduling
MUTUAL_FUND_SYNC_CRON=-

# Redis is not yet wired up (see finadvisor.config.CacheConfig) - reserved for future use
REDIS_URL=

# AMFI mutual fund NAV provider (Phase 3.5). Set MUTUAL_FUND_PROVIDER_NAME=amfi to use real AMFI data
# instead of the demo provider. AMFI is a free, public data source - no credentials required.
AMFI_BASE_URL=https://www.amfiindia.com/spragmt/NAVAll.txt
AMFI_CACHE_TTL_MINUTES=60

# Stock market-data provider (Phase 3.5). Leave STOCK_DATA_PROVIDER unset to run without stock data.
STOCK_DATA_PROVIDER=UPSTOX
STOCK_PROVIDER_TIMEOUT=5000
STOCK_PROVIDER_MAX_RETRIES=3
# Must stay false unless a real provider is configured - gates the scheduled stock sync jobs
STOCK_PROVIDER_ENABLED=false

# Upstox read-only Analytics Token (see https://upstox.com/developer/api-documentation/analytics-token).
# Server-side only - never place this in a NEXT_PUBLIC_* frontend variable, log it, or return it in any API response.
UPSTOX_API_BASE_URL=https://api.upstox.com
UPSTOX_ANALYTICS_TOKEN=<replace-with-your-upstox-analytics-token>
UPSTOX_CACHE_TTL_MINUTES=30

# Cron expressions for scheduled stock sync; "-" (default) disables scheduling (manual/admin-triggered only)
STOCK_INSTRUMENT_SYNC_CRON=-
STOCK_EOD_SYNC_CRON=-

